# Bind address: use your server's Tailscale IP so the dashboard is ONLY reachable
# from your Tailscale network, never from the public internet.
# Find it on the server with: tailscale ip -4
HOST=100.93.127.109
PORT=4500

# How often (ms) to poll system + site stats and store a snapshot
POLL_INTERVAL_MS=10000

# How long (days) to keep historical snapshots in SQLite before pruning
RETENTION_DAYS=30
