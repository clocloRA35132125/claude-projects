[Unit]
Description=Server Dashboard (private monitoring UI, Tailscale only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/server-dashboard
EnvironmentFile=%h/server-dashboard/.env
ExecStart=/usr/bin/node src/server.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
